<?xml version="1.0" encoding="utf-8"?>
<!--
  Vabu canlı + kurulum ISO'su (Kiwi NG). Fedora da kendi canlı ISO'larını Kiwi ile üretir.
  @FEDORA@ ve @ARCH@ derleme sırasında Fedora sürümü ve mimariyle (x86_64 / aarch64) değiştirilir (bkz. .github/workflows/iso.yml).
  Yerelde (Fedora makinede, root):  just iso
-->
<image schemaversion="7.5" name="Vabu-Live">
  <description type="system">
    <author>Vabu</author>
    <contact>https://github.com/ii-las/vabu</contact>
    <specification>Vabu canlı ve kurulum ISO'su</specification>
  </description>

  <preferences>
    <version>0.1.0</version>
    <release-version>@FEDORA@</release-version>
    <packagemanager>dnf5</packagemanager>
    <locale>tr_TR</locale>
    <keytable>trq</keytable>
    <timezone>Europe/Istanbul</timezone>
    <rpm-check-signatures>false</rpm-check-signatures>
    <bootsplash-theme>vabu</bootsplash-theme>
    <bootloader-theme>vabu</bootloader-theme>
    <!-- filesystem="erofs": dracut canlı kökü overlayfs ile /run/rootfsbase altına bağlar;
         Calamares unpackfs sistemi oradan kopyalar. Fedora'nın kendi canlı ISO'ları da böyle. -->
    <type image="iso" primary="true" flags="dmsquash" filesystem="erofs" firmware="uefi"
          mediacheck="false" efifatimagesize="30" publisher="Vabu" volid="VABU_LIVE"
          kernelcmdline="rhgb quiet">
      <bootloader name="grub2" console="gfxterm" timeout="5"/>
    </type>
  </preferences>

  <repository type="rpm-md" alias="fedora" priority="10">
    <source path="https://dl.fedoraproject.org/pub/fedora/linux/releases/@FEDORA@/Everything/@ARCH@/os/"/>
  </repository>
  <repository type="rpm-md" alias="fedora-updates" priority="10">
    <source path="https://dl.fedoraproject.org/pub/fedora/linux/updates/@FEDORA@/Everything/@ARCH@/"/>
  </repository>
  <repository type="rpm-md" alias="rpmfusion-free" priority="20">
    <source path="https://download1.rpmfusion.org/free/fedora/releases/@FEDORA@/Everything/@ARCH@/os/"/>
  </repository>
  <repository type="rpm-md" alias="rpmfusion-free-updates" priority="20">
    <source path="https://download1.rpmfusion.org/free/fedora/updates/@FEDORA@/@ARCH@/"/>
  </repository>
  <repository type="rpm-md" alias="rpmfusion-nonfree" priority="20">
    <source path="https://download1.rpmfusion.org/nonfree/fedora/releases/@FEDORA@/Everything/@ARCH@/os/"/>
  </repository>
  <repository type="rpm-md" alias="rpmfusion-nonfree-updates" priority="20">
    <source path="https://download1.rpmfusion.org/nonfree/fedora/updates/@FEDORA@/@ARCH@/"/>
  </repository>
  <repository type="rpm-md" alias="vabu" priority="5">
    <source path="https://download.copr.fedorainfracloud.org/results/ii-las/vabu/fedora-@FEDORA@-@ARCH@/"/>
  </repository>

  <packages type="bootstrap">
    <package name="filesystem"/>
    <package name="fedora-gpg-keys"/>
    <package name="fedora-repos"/>
    <package name="vabu-release"/>
    <package name="dnf5"/>
  </packages>

  <!-- plusRecommended: linux-firmware gibi paketlerin önerdiği GPU/Wi-Fi firmware'leri de gelsin -->
  <packages type="image" patternType="plusRecommended">
    <!-- Temel sistem ve açılış -->
    <package name="kernel"/>
    <package name="kernel-modules-extra"/>
    <package name="linux-firmware"/>
    <package name="dracut-live"/>
    <package name="grub2-efi-x64" arch="x86_64"/>
    <package name="grub2-efi-x64-cdboot" arch="x86_64"/>
    <package name="grub2-pc" arch="x86_64"/>
    <package name="shim-x64" arch="x86_64"/>
    <package name="grub2-efi-aa64" arch="aarch64"/>
    <package name="grub2-efi-aa64-cdboot" arch="aarch64"/>
    <package name="shim-aa64" arch="aarch64"/>
    <package name="grub2-efi-aa64-modules" arch="aarch64"/>
    <package name="efibootmgr"/>
    <package name="plymouth"/>
    <package name="btrfs-progs"/>
    <package name="cryptsetup"/>
    <package name="NetworkManager-wifi"/>
    <package name="sudo"/>
    <package name="generic-logos"/>
    <package name="glibc-langpack-tr"/>
    <package name="glibc-langpack-en"/>

    <!-- Depolar: kurulan sistemde de açık kalır -->
    <package name="rpmfusion-free-release"/>
    <package name="rpmfusion-nonfree-release"/>

    <!-- Grafik: Mesa (AMD/Intel/nouveau) hazır gelir; NVIDIA sürücüsü kurulumdan sonra
         vabu-drivers ile kurulur (akmod derlemesi hedef çekirdekte yapılmalı). -->
    <package name="mesa-dri-drivers"/>
    <package name="mesa-vulkan-drivers"/>
    <package name="mesa-va-drivers-freeworld"/>
    <package name="intel-media-driver" arch="x86_64"/>
    <package name="ffmpeg"/>

    <!-- Vabu -->
    <package name="vabu-desktop"/>
    <package name="vabu-shell"/>
    <package name="calamares"/>
    <!-- Sanal makinelerde ekran ve pano paylaşımı -->
    <package name="spice-vdagent"/>
    <package name="qemu-guest-agent"/>
  </packages>
</image>
