/* Vabu kurulum teması - QML olmayan Calamares sayfaları (konum, klavye, disk) için.
   Renkler: gece #121216, taş #26242C, gök #A9C7F7, nane #8EF0C6. */

QWidget {
    background: #121216;
    color: #F3F1EC;
    font-family: "Geist";
    font-size: 14px;
}

/* Sayfa başlıkları büyük serif */
QLabel#pageTitle, QLabel#m_title, QLabel[class="title"] {
    font-family: "Instrument Serif";
    font-size: 40px;
}

QLabel { background: transparent; }

QPushButton {
    background: #26242C;
    border: none;
    border-radius: 22px;
    padding: 12px 24px;
    min-height: 20px;
}
QPushButton:hover { background: #34313B; }
QPushButton:disabled { color: #8E8B93; }

QLineEdit, QComboBox, QSpinBox {
    background: #34313B;
    border: 2px solid #26242C;
    border-radius: 12px;
    padding: 10px 14px;
    selection-background-color: #A9C7F7;
    selection-color: #14243F;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border-color: #A9C7F7; }
QComboBox::drop-down { border: none; width: 28px; }
QComboBox QAbstractItemView {
    background: #1D1C22;
    border: 1px solid #34313B;
    border-radius: 12px;
    selection-background-color: #A9C7F7;
    selection-color: #14243F;
    padding: 6px;
}

/* Disk sayfası seçenekleri */
QRadioButton {
    background: #1D1C22;
    border: 1px solid #34313B;
    border-radius: 22px;
    padding: 16px 20px;
    spacing: 12px;
    font-size: 15px;
}
QRadioButton:checked { background: #A9C7F7; color: #14243F; border-color: #A9C7F7; }
QRadioButton::indicator { width: 18px; height: 18px; border-radius: 9px; border: 2px solid #8E8B93; background: transparent; }
QRadioButton::indicator:checked { border-color: #14243F; background: #14243F; }

QCheckBox { spacing: 10px; }
QCheckBox::indicator { width: 20px; height: 20px; border-radius: 6px; border: 2px solid #8E8B93; background: transparent; }
QCheckBox::indicator:checked { background: #8EF0C6; border-color: #8EF0C6; }

QListView, QTreeView, QTableView {
    background: #1D1C22;
    alternate-background-color: #1D1C22;
    border: 1px solid #26242C;
    border-radius: 14px;
    padding: 6px;
    outline: none;
}
QListView::item, QTreeView::item { padding: 8px; border-radius: 10px; }
QListView::item:selected, QTreeView::item:selected, QTableView::item:selected { background: #A9C7F7; color: #14243F; }
QHeaderView::section { background: #121216; color: #A3A1A8; border: none; padding: 6px; font-family: "Geist Mono"; font-size: 11px; }

QSlider::groove:horizontal { height: 6px; background: #26242C; border-radius: 3px; }
QSlider::sub-page:horizontal { background: #A9C7F7; border-radius: 3px; }
QSlider::handle:horizontal { background: #F3F1EC; width: 20px; margin: -7px 0; border-radius: 10px; }

QProgressBar { background: #26242C; border: none; border-radius: 5px; height: 10px; text-align: center; color: transparent; }
QProgressBar::chunk { background: #8EF0C6; border-radius: 5px; }

QScrollBar:vertical { background: transparent; width: 10px; }
QScrollBar::handle:vertical { background: #34313B; border-radius: 5px; min-height: 30px; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; }

QToolTip { background: #1D1C22; color: #F3F1EC; border: 1px solid #34313B; border-radius: 8px; padding: 6px; }
