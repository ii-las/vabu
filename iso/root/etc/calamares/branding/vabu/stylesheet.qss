/* Vabu kurulum teması - QML olmayan Calamares sayfaları (konum, klavye, disk) için.
   Renkler: gece #151318, taş #221F26, gök #EFECE6, nane #EFECE6. */

QWidget {
    background: #151318;
    color: #EFECE6;
    font-family: "Hanken Grotesk";
    font-size: 14px;
}

/* Sayfa başlıkları büyük serif */
QLabel#pageTitle, QLabel#m_title, QLabel[class="title"] {
    font-family: "Hanken Grotesk"; font-weight: 600;
    font-size: 40px;
}

QLabel { background: transparent; }

QPushButton {
    background: #221F26;
    border: none;
    border-radius: 22px;
    padding: 12px 24px;
    min-height: 20px;
}
QPushButton:hover { background: #2C2931; }
QPushButton:disabled { color: #8C8882; }

QLineEdit, QComboBox, QSpinBox {
    background: #2C2931;
    border: 2px solid #221F26;
    border-radius: 12px;
    padding: 10px 14px;
    selection-background-color: #EFECE6;
    selection-color: #141316;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border-color: #EFECE6; }
QComboBox::drop-down { border: none; width: 28px; }
QComboBox QAbstractItemView {
    background: #1B191E;
    border: 1px solid #2C2931;
    border-radius: 12px;
    selection-background-color: #EFECE6;
    selection-color: #141316;
    padding: 6px;
}

/* Disk sayfası seçenekleri */
QRadioButton {
    background: #1B191E;
    border: 1px solid #2C2931;
    border-radius: 22px;
    padding: 16px 20px;
    spacing: 12px;
    font-size: 15px;
}
QRadioButton:checked { background: #EFECE6; color: #141316; border-color: #EFECE6; }
QRadioButton::indicator { width: 18px; height: 18px; border-radius: 9px; border: 2px solid #8C8882; background: transparent; }
QRadioButton::indicator:checked { border-color: #141316; background: #141316; }

QCheckBox { spacing: 10px; }
QCheckBox::indicator { width: 20px; height: 20px; border-radius: 6px; border: 2px solid #8C8882; background: transparent; }
QCheckBox::indicator:checked { background: #EFECE6; border-color: #EFECE6; }

QListView, QTreeView, QTableView {
    background: #1B191E;
    alternate-background-color: #1B191E;
    border: 1px solid #221F26;
    border-radius: 14px;
    padding: 6px;
    outline: none;
}
QListView::item, QTreeView::item { padding: 8px; border-radius: 10px; }
QListView::item:selected, QTreeView::item:selected, QTableView::item:selected { background: #EFECE6; color: #141316; }
QHeaderView::section { background: #151318; color: #A39E97; border: none; padding: 6px; font-family: "Hanken Grotesk"; font-size: 11px; }

QSlider::groove:horizontal { height: 6px; background: #221F26; border-radius: 3px; }
QSlider::sub-page:horizontal { background: #EFECE6; border-radius: 3px; }
QSlider::handle:horizontal { background: #EFECE6; width: 20px; margin: -7px 0; border-radius: 10px; }

QProgressBar { background: #221F26; border: none; border-radius: 5px; height: 10px; text-align: center; color: transparent; }
QProgressBar::chunk { background: #EFECE6; border-radius: 5px; }

QScrollBar:vertical { background: transparent; width: 10px; }
QScrollBar::handle:vertical { background: #2C2931; border-radius: 5px; min-height: 30px; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; }

QToolTip { background: #1B191E; color: #EFECE6; border: 1px solid #2C2931; border-radius: 8px; padding: 6px; }
