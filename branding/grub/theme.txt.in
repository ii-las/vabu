# Vabu önyükleme menüsü.
# Yazı tipi adları derleme sırasında üretilen .pf2 dosyalarından okunup yerine yazılır.

title-text: ""
desktop-image: "background.png"
desktop-image-scale-method: "crop"
desktop-color: "#0F0E11"
terminal-font: "@FONT_MONO@"
terminal-box: "terminal_box_*.png"
terminal-left: "16%"
terminal-top: "16%"
terminal-width: "68%"
terminal-height: "68%"
terminal-border: "24"

+ image {
    left = 50%-52
    top = 17%
    width = 104
    height = 104
    file = "logo.png"
}

+ boot_menu {
    left = 50%-290
    top = 38%
    width = 580
    height = 42%
    item_font = "@FONT_L@"
    item_color = "#CFCBC4"
    selected_item_color = "#0E1A33"
    item_height = 30
    item_padding = 22
    item_spacing = 30
    icon_width = 0
    icon_height = 0
    item_icon_space = 0
    selected_item_pixmap_style = "select_*.png"
    scrollbar = false
}
