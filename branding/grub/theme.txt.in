# Vabu önyükleme menüsü.
# Yazı tipi adları derleme sırasında üretilen .pf2 dosyalarından okunup yerine yazılır.

title-text: ""
desktop-image: "background.png"
desktop-image-scale-method: "crop"
desktop-color: "#0F0E11"
terminal-font: "@FONT_S@"
terminal-left: "12%"
terminal-top: "12%"
terminal-width: "76%"
terminal-height: "76%"
terminal-border: "0"

+ image {
    left = 50%-52
    top = 17%
    width = 104
    height = 104
    file = "logo.png"
}

+ boot_menu {
    left = 50%-290
    top = 38%
    width = 580
    height = 42%
    item_font = "@FONT_L@"
    item_color = "#CFCBC4"
    selected_item_color = "#0E1A33"
    item_height = 54
    item_padding = 22
    item_spacing = 6
    icon_width = 0
    icon_height = 0
    item_icon_space = 0
    selected_item_pixmap_style = "select_*.png"
    scrollbar = false
}

+ progress_bar {
    id = "__timeout__"
    left = 50%-80
    top = 100%-84
    width = 160
    height = 4
    fg_color = "#F0EEE9"
    bg_color = "#3A3740"
    border_color = "#3A3740"
    show_text = false
}
