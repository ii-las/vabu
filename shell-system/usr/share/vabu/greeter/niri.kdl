// Vabu giriş ekranı için en küçük niri ayarı (greetd kullanıcısıyla çalışır).
input {
    keyboard {
        xkb {
            // Kurulumun localectl ile seçtiği sistem klavyesini kullan.
        }
    }
    touchpad {
        tap
    }
}

hotkey-overlay {
    skip-at-startup
}

cursor {
    xcursor-theme "Adwaita"
}

spawn-at-startup "/usr/libexec/vabu/greeter-shell"

binds {
}
