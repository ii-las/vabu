# Vabu açılış ekranı: koyu zemin, ortada nefes alan logo, disk şifresi istemi.
Window.SetBackgroundTopColor(0.07, 0.08, 0.11);
Window.SetBackgroundBottomColor(0.05, 0.06, 0.09);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2);

tick = 0;
fun refresh_callback() {
    tick++;
    logo.sprite.SetOpacity(0.7 + 0.3 * Math.Sin(tick / 25));
}
Plymouth.SetRefreshFunction(refresh_callback);

# --- Disk şifresi (LUKS) istemi ---
prompt.sprite = Sprite();
bullets.sprite = Sprite();

fun display_password_callback(prompt_text, bullet_count) {
    text = prompt_text;
    if (text == "") text = "Disk şifresi";
    prompt.image = Image.Text(text, 0.9, 0.91, 0.95);
    prompt.sprite.SetImage(prompt.image);
    prompt.sprite.SetX(Window.GetWidth() / 2 - prompt.image.GetWidth() / 2);
    prompt.sprite.SetY(Window.GetHeight() / 2 + logo.image.GetHeight() / 2 + 40);
    prompt.sprite.SetOpacity(1);

    dots = "";
    for (i = 0; i < bullet_count; i++) dots = dots + "● ";
    bullets.image = Image.Text(dots, 0.37, 0.92, 0.83);
    bullets.sprite.SetImage(bullets.image);
    bullets.sprite.SetX(Window.GetWidth() / 2 - bullets.image.GetWidth() / 2);
    bullets.sprite.SetY(Window.GetHeight() / 2 + logo.image.GetHeight() / 2 + 75);
    bullets.sprite.SetOpacity(1);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
    prompt.sprite.SetOpacity(0);
    bullets.sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

fun message_callback(text) {
    msg.image = Image.Text(text, 0.6, 0.64, 0.72);
    msg.sprite = Sprite(msg.image);
    msg.sprite.SetX(Window.GetWidth() / 2 - msg.image.GetWidth() / 2);
    msg.sprite.SetY(Window.GetHeight() - 80);
}
Plymouth.SetMessageFunction(message_callback);
