# Vabu açılış ekranı: koyu zemin, ortada işaret, altında ince ilerleme çizgisi.
# Disk şifreliyse şifre istemi aynı yerde belirir.
Window.SetBackgroundTopColor(0.1255, 0.1412, 0.1255);
Window.SetBackgroundBottomColor(0.1255, 0.1412, 0.1255);

W = Window.GetWidth();
H = Window.GetHeight();

# Ölçüler ekran yüksekliğine göre: 4K'da da 1080p'de de aynı oranda görünür
size = Math.Int(H * 0.11);
if (size < 96) size = 96;

logo.image = Image("logo.png").Scale(size, size);
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(W / 2 - size / 2);
logo.sprite.SetY(H / 2 - size / 2 - size * 0.2);
logo.sprite.SetOpacity(0);

bar.w = Math.Int(size * 1.4);
bar.h = Math.Int(H / 400);
if (bar.h < 2) bar.h = 2;
bar.x = W / 2 - bar.w / 2;
bar.y = H / 2 + size * 0.75;

track.sprite = Sprite(Image("track.png").Scale(bar.w, bar.h));
track.sprite.SetPosition(bar.x, bar.y, 1);
track.sprite.SetOpacity(0);

fill.src = Image("fill.png");
fill.sprite = Sprite();
fill.sprite.SetPosition(bar.x, bar.y, 2);
fill.sprite.SetOpacity(0);

tick = 0;
progress = 0;
shown = 0;
asking = 0;

fun refresh_callback() {
    tick++;
    # yumuşak belirme
    fade = tick / 30;
    if (fade > 1) fade = 1;
    logo.sprite.SetOpacity(fade);
    if (asking == 0) {
        track.sprite.SetOpacity(fade);
        fill.sprite.SetOpacity(fade);
    }
    # çizgi hedefe doğru akar, sıçramaz
    shown = shown + (progress - shown) * 0.08;
    w = Math.Int(bar.w * shown);
    if (w < 1) w = 1;
    fill.sprite.SetImage(fill.src.Scale(w, bar.h));
}
Plymouth.SetRefreshFunction(refresh_callback);

fun progress_callback(duration, value) {
    if (value > progress) progress = value;
}
Plymouth.SetBootProgressFunction(progress_callback);

fun quit_callback() {
    progress = 1;
}
Plymouth.SetQuitFunction(quit_callback);

# --- Disk şifresi (LUKS) istemi ---
prompt.sprite = Sprite();
bullets.sprite = Sprite();

fun display_password_callback(prompt_text, bullet_count) {
    asking = 1;
    track.sprite.SetOpacity(0);
    fill.sprite.SetOpacity(0);

    text = prompt_text;
    if (text == "") text = "Disk şifresi";
    prompt.image = Image.Text(text, 0.94, 0.93, 0.90, 1, "Hanken Grotesk 13");
    prompt.sprite.SetImage(prompt.image);
    prompt.sprite.SetPosition(W / 2 - prompt.image.GetWidth() / 2, bar.y - 4, 3);
    prompt.sprite.SetOpacity(1);

    dots = "";
    for (i = 0; i < bullet_count; i++) dots = dots + "● ";
    bullets.image = Image.Text(dots, 0.94, 0.93, 0.90, 1, "Hanken Grotesk 11");
    bullets.sprite.SetImage(bullets.image);
    bullets.sprite.SetPosition(W / 2 - bullets.image.GetWidth() / 2, bar.y + 34, 3);
    bullets.sprite.SetOpacity(1);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
    asking = 0;
    prompt.sprite.SetOpacity(0);
    bullets.sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

msg.sprite = Sprite();
fun message_callback(text) {
    msg.image = Image.Text(text, 0.64, 0.62, 0.59, 1, "Hanken Grotesk 11");
    msg.sprite.SetImage(msg.image);
    msg.sprite.SetPosition(W / 2 - msg.image.GetWidth() / 2, H - 80, 3);
}
Plymouth.SetMessageFunction(message_callback);
