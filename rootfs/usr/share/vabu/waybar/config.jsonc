{
  "layer": "top",
  "position": "top",
  "height": 36,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 6,

  "modules-left": ["custom/vabu", "niri/workspaces", "niri/window"],
  "modules-center": ["clock"],
  "modules-right": ["tray", "power-profiles-daemon", "pulseaudio", "network", "battery", "custom/power"],

  "custom/vabu": {
    "format": "  ",
    "tooltip-format": "Vabu - uygulamalar (Super+Space)",
    "on-click": "vabu-launcher"
  },

  "niri/workspaces": {
    "format": "{index}"
  },

  "niri/window": {
    "max-length": 48,
    "separate-outputs": true
  },

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%A %d %B %Y  %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "locale": "tr_TR.UTF-8"
  },


  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Güç profili: {profile}",
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "  sessiz",
    "format-icons": { "default": ["", "", ""] },
    "on-click": "pavucontrol",
    "scroll-step": 5
  },

  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "  kablolu",
    "format-disconnected": "  bağlı değil",
    "tooltip-format": "{ifname} - {ipaddr}",
    "on-click": "nm-connection-editor"
  },

  "battery": {
    "states": { "warning": 25, "critical": 10 },
    "format": "{icon}  {capacity}%",
    "format-charging": "  {capacity}%",
    "format-icons": ["", "", "", "", ""]
  },

  "custom/power": {
    "format": "",
    "tooltip-format": "Oturum menüsü",
    "on-click": "vabu-power-menu"
  }
}
