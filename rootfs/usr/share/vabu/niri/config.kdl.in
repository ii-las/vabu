// VABU-AYARLAR-YÖNETİR
// Vabu - niri yapılandırması. Bu dosyayı Vabu Ayarlar üretir (/usr/libexec/vabu/niri-config).
// Ayarlar'ın yönetmesini istemiyorsan ilk satırı sil; o zaman dosya tamamen senindir.
// Şablon: /usr/share/vabu/niri/config.kdl.in · Kısayollar: Super + Shift + /

input {
    keyboard {
        xkb {
            @@XKB_CONFIG@@
        }
    }
    touchpad {
        tap
        @@NATURAL_SCROLL@@
        dwt
    }
    warp-mouse-to-focus
}

layout {
    gaps @@GAPS@@
    center-focused-column "on-overflow"
    // Çalışma alanlarının kendi zemini yok: arkadaki duvar kağıdı görünür
    background-color "transparent"
    // Tek pencere ekranın ortasında durur
    always-center-single-column

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-color "@@FOCUS_COLOR@@"
        inactive-color "#7A8494"
    }

    border {
        off
    }

    shadow {
        on
        softness 30
        spread 4
        offset x=0 y=6
        color "#00000088"
    }
}

prefer-no-csd

@@ANIMATIONS@@

// Ekranlar (Vabu Ayarlar > Ekranlar)
@@OUTPUTS@@

// Adlandırılmış alanlar ve uygulama atamaları
@@WORKSPACES@@

screenshot-path "~/Pictures/Screenshots/%Y-%m-%d %H-%M-%S.png"

// Genel bakış (Super + O): çalışma alanları küçülür, arkada duvar kağıdı kalır
overview {
    zoom 0.5
    backdrop-color "#202420"
}

// Duvar kağıdı çalışma alanlarıyla birlikte kaymaz, hep yerinde durur.
// Yan paneldeki buzlu cam görüntüsü de buna dayanır.
layer-rule {
    match namespace="^vabu-wallpaper$"
    place-within-backdrop true
}

hotkey-overlay {
    skip-at-startup
}

environment {
    // Vabu varsayılan uygulama ayarları (ör. foot teması) /etc/xdg'den önce okunur;
    // paketlerin kendi dosyalarıyla çakışmaz, kullanıcı ayarı (~/.config) yine önceliklidir
    XDG_CONFIG_DIRS "/usr/share/vabu/xdg:/etc/xdg"
    QT_QPA_PLATFORM "wayland"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
}

// Oturum: Vabu Shell ve arka plan servisleri
spawn-at-startup "/usr/libexec/vabu/session-start"

// Tüm pencereler: yuvarlatılmış köşeler.
window-rule {
    geometry-corner-radius @@RADIUS@@
    clip-to-geometry true
}

// Küçük yardımcı pencereler yüzer açılsın.
window-rule {
    match app-id=r#"^org\.gnome\.Calculator$"#
    match app-id=r#"^org\.pulseaudio\.pavucontrol$"#
    match app-id=r#"^\.?blueman-manager"#
    match app-id=r#"^nm-connection-editor$"#
    match app-id="^vabu-shell-error$"
    open-floating true
}

// Ayarlar diğer pencereler gibi döşenir; gezinme ile içerik sığsın diye biraz geniş açılır.
window-rule {
    match app-id=r#"^org\.quickshell$"# title="^Vabu Ayarlar$"
    default-column-width { proportion 0.66667; }
}

// Oyunlar tam ekran açılsın.
window-rule {
    match app-id=r#"^steam_app_"#
    match app-id=r#"^gamescope$"#
    open-fullscreen true
}

binds {
    Mod+Shift+Slash hotkey-overlay-title="Kısayollar" { spawn "qs" "-p" "/usr/share/vabu/shell" "ipc" "call" "shortcuts" "toggle"; }
    Mod+Ctrl+Slash { show-hotkey-overlay; }

    // Uygulamalar
    Mod+Tab { spawn "qs" "-p" "/usr/share/vabu/shell" "ipc" "call" "launcher" "open" "windows"; }
    Mod+P { spawn "qs" "-p" "/usr/share/vabu/shell" "ipc" "call" "clipboard" "toggle"; }
    Mod+Return hotkey-overlay-title="Terminal" { spawn "foot"; }
    Mod+Space hotkey-overlay-title="Ara ve başlat" { spawn "vabu-launcher"; }
    Mod+I hotkey-overlay-title="Uygulama kur" { spawn "vabu-launcher" "--install"; }
    Mod+E hotkey-overlay-title="Dosyalar" { spawn "nautilus"; }
    Mod+Comma hotkey-overlay-title="Ayarlar" { spawn "vabu-settings"; }
    Super+Alt+L hotkey-overlay-title="Ekranı kilitle" { spawn "/usr/libexec/vabu/lock"; }

    // Ses ve parlaklık
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.05+" "-l" "1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.05-"; }
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86AudioPlay        allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext        allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev        allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "vabu-brightness" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "vabu-brightness" "5%-"; }

    // Pencereler
    Mod+Q { close-window; }
    Mod+O repeat=false { toggle-overview; }

    // Yön tuşları tek bir haritada gezer: sağ-sol kolonlar, yukarı-aşağı önce kolondaki
    // pencereler, kolonun ucuna gelince komşu çalışma alanı.
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-or-workspace-up; }
    Mod+Down  { focus-window-or-workspace-down; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+K     { focus-window-or-workspace-up; }
    Mod+J     { focus-window-or-workspace-down; }

    // Shift ile aynı yöne taşır
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up-or-to-workspace-up; }
    Mod+Shift+Down  { move-window-down-or-to-workspace-down; }
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+L     { move-column-right; }
    Mod+Shift+K     { move-window-up-or-to-workspace-up; }
    Mod+Shift+J     { move-window-down-or-to-workspace-down; }

    // Ctrl ile ekranlar arasında
    Mod+Ctrl+Left        { focus-monitor-left; }
    Mod+Ctrl+Right       { focus-monitor-right; }
    Mod+Ctrl+Shift+Left  { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+Right { move-column-to-monitor-right; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }

    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    Mod+R       { switch-preset-column-width; }
    Mod+F       { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C       { center-column; }
    Mod+V       { toggle-window-floating; }
    Mod+Minus   { set-column-width "-10%"; }
    Mod+Equal   { set-column-width "+10%"; }

    // Çalışma alanları: alt alta dizilir, sonda her zaman boş bir alan bekler
    Mod+Page_Down       { focus-workspace-down; }
    Mod+Page_Up         { focus-workspace-up; }
    Mod+Shift+Page_Down { move-column-to-workspace-down; }
    Mod+Shift+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+Page_Down  { move-workspace-down; }
    Mod+Ctrl+Page_Up    { move-workspace-up; }

    Mod+WheelScrollDown       cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp         cooldown-ms=150 { focus-workspace-up; }
    Mod+Shift+WheelScrollDown cooldown-ms=120 { focus-column-right; }
    Mod+Shift+WheelScrollUp   cooldown-ms=120 { focus-column-left; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // Ekran görüntüsü
    Print      { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print  { screenshot-window; }

    // Oturum
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+P { power-off-monitors; }
    Mod+Shift+E hotkey-overlay-title="Oturum menüsü" { spawn "qs" "-p" "/usr/share/vabu/shell" "ipc" "call" "session" "toggle"; }
    Mod+N hotkey-overlay-title="Bildirimler" { spawn "qs" "-p" "/usr/share/vabu/shell" "ipc" "call" "panel" "toggle" "notifications"; }
    Mod+A hotkey-overlay-title="Kontrol merkezi" { spawn "qs" "-p" "/usr/share/vabu/shell" "ipc" "call" "panel" "toggle" "control"; }
}

// --- Kendi eklemelerin -------------------------------------------------------
// Vabu Ayarlar bu dosyayı yeniden üretirken aşağıdaki bölümü korur.
// VABU-KULLANICI-BAŞLANGIÇ
@@USER@@
// VABU-KULLANICI-SON
