# Vabu bildirim teması
font=Hanken Grotesk 11
background-color=#202420ff
text-color=#F0EEE9
border-color=#A9BFFF
progress-color=over #A9BFFF55
border-size=2
border-radius=14
padding=14
margin=12
width=380
icons=1
max-icon-size=48
default-timeout=6000
max-visible=4
layer=overlay

[urgency=low]
border-color=#30362F

[urgency=critical]
border-color=#F09A8E
default-timeout=0

[app-name=vabu]
border-color=#A9BFFF

# Oyun modu: normal bildirimleri gizle, kritikler yine görünsün.
[mode=do-not-disturb]
invisible=1

[mode=do-not-disturb urgency=critical]
invisible=0
