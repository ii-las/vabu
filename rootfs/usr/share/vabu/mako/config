# Vabu bildirim teması
font=Inter 11
background-color=#1b1e2aee
text-color=#e6e9f2
border-color=#5eead4
progress-color=over #a78bfa55
border-size=2
border-radius=14
padding=14
margin=12
width=380
icons=1
max-icon-size=48
default-timeout=6000
max-visible=4
layer=overlay

[urgency=low]
border-color=#2a2f3d

[urgency=critical]
border-color=#fb7185
default-timeout=0

[app-name=vabu]
border-color=#a78bfa

# Oyun modu: normal bildirimleri gizle, kritikler yine görünsün.
[mode=do-not-disturb]
invisible=1

[mode=do-not-disturb urgency=critical]
invisible=0
