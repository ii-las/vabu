input { keyboard { xkb {} }; touchpad { tap; } }
hotkey-overlay { skip-at-startup; }
spawn-at-startup "/usr/libexec/vabu/recovery-start"
binds {
    Mod+Return { spawn "foot"; }
    Mod+Space { spawn "fuzzel"; }
    Mod+E { spawn "nautilus"; }
    Mod+Q { close-window; }
    Mod+Shift+E { quit; }
    Super+Alt+L { spawn "/usr/libexec/vabu/lock"; }
}
