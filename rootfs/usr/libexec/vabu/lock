#!/usr/bin/env bash
# IPC dönüşü yalnızca isteğin alındığını söyler; compositor onayını da bekle.
if command -v qs >/dev/null && timeout 3 qs -p /usr/share/vabu/shell ipc call lock lock >/dev/null 2>&1; then
    deadline=$((SECONDS + 5))
    while ((SECONDS < deadline)); do
        secure="$(timeout 1 qs -p /usr/share/vabu/shell ipc call lock isSecure 2>/dev/null)" || break
        [[ "$secure" == true ]] && exit 0
        sleep 0.1
    done
    echo "Vabu kilit onayı alınamadı; yedek kilit deneniyor." >&2
fi
exec swaylock -f -c 121216 --ring-color 8EF0C6 --key-hl-color A9C7F7 --inside-color 121216 \
    --line-color 00000000 --separator-color 00000000 --text-color F3F1EC
