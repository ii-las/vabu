#!/usr/bin/python3 -I
"""Preview niri outputs with a rollback guard independent of the settings process."""
import fcntl
import json
import math
import os
from pathlib import Path
import re
import shutil
import signal
import socket
import stat
import subprocess
import sys
import tempfile
import time


def runtime():
    path = Path(os.environ['XDG_RUNTIME_DIR'])
    info = path.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise ValueError('Güvenli oturum dizini bulunamadı.')
    return path


def request(token, action):
    if not re.fullmatch(r'vabu-display-[a-z0-9_]+', token):
        raise ValueError('Geçersiz önizleme kimliği.')
    with socket.socket(socket.AF_UNIX) as client:
        client.settimeout(40)
        client.connect(str(runtime() / token / 'control'))
        client.sendall(action.encode() + b'\n')
        reply = client.recv(4096).decode().strip()
        if reply not in ('ready', 'done'):
            raise RuntimeError(reply or 'Önizleme yanıt vermedi.')
        return reply


def command(args):
    result = subprocess.run(['niri', 'msg', *args], capture_output=True, text=True, timeout=5)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or 'Ekran ayarı uygulanamadı.')
    return result.stdout


def current():
    outputs = json.loads(command(['-j', 'outputs']))
    before = {}
    for name, output in outputs.items():
        logical = output.get('logical')
        index = output.get('current_mode')
        mode = output['modes'][index] if index is not None else None
        before[name] = {
            'off': logical is None,
            'mode': f"{mode['width']}x{mode['height']}@{mode['refresh_rate'] / 1000:.3f}" if mode else '',
            'scale': logical['scale'] if logical else 1,
            'x': logical['x'] if logical else 0,
            'y': logical['y'] if logical else 0,
            'vrr': bool(output.get('vrr_enabled')),
        }
    return before


def validate(state, before):
    if not isinstance(state, dict) or set(state) != set(before):
        raise ValueError('Ekran listesi değişti; yeniden denetle.')
    if not all(isinstance(s, dict) for s in state.values()):
        raise ValueError('Geçersiz ekran ayarı.')
    if all(s.get('off') for s in state.values()):
        raise ValueError('En az bir ekran açık kalmalı.')
    for name, s in state.items():
        mode = s.get('mode', '')
        if mode and not re.fullmatch(r'\d+x\d+(@\d+(\.\d+)?)?', mode):
            raise ValueError('Geçersiz ekran kipi.')
        scale = s.get('scale', 1)
        if not isinstance(scale, (int, float)) or not math.isfinite(scale) or not 0.5 <= scale <= 4:
            raise ValueError('Geçersiz ölçek.')
        for axis in ('x', 'y'):
            value = s.get(axis, 0)
            if not isinstance(value, (int, float)) or not math.isfinite(value) or abs(value) > 100000:
                raise ValueError('Geçersiz ekran konumu.')


def apply(state, best_effort=False):
    errors = []
    # Restore usable outputs before disabling others.
    for name, s in sorted(state.items(), key=lambda item: bool(item[1].get('off'))):
        commands = [['off']] if s.get('off') else [['on']]
        if not s.get('off'):
            if s.get('mode'):
                commands.append(['mode', s['mode']])
            commands += [['scale', str(s.get('scale', 1))],
                         ['position', 'set', '--', str(round(s.get('x', 0))), str(round(s.get('y', 0)))],
                         ['vrr', 'on' if s.get('vrr') else 'off']]
        for args in commands:
            try:
                command(['output', name, *args])
            except (OSError, RuntimeError, subprocess.SubprocessError) as error:
                if not best_effort:
                    raise
                errors.append(str(error))
    if errors:
        raise RuntimeError('; '.join(errors))


def guard(token, before, draft):
    directory = runtime() / token
    keep = False
    changed = False
    lock = None
    def stop(*_):
        raise InterruptedError('Önizleme sonlandırıldı.')
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    try:
        lock = os.open(runtime() / 'vabu-display.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        with socket.socket(socket.AF_UNIX) as server:
            server.bind(str(directory / 'control'))
            server.listen(2)
            changed = True
            apply(draft)
            deadline = time.monotonic() + 15
            while True:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    break
                server.settimeout(remaining)
                try:
                    conn, _ = server.accept()
                except socket.timeout:
                    break
                with conn:
                    conn.settimeout(min(1, remaining))
                    try:
                        action = conn.recv(32).decode().strip()
                    except socket.timeout:
                        continue
                    if action == 'status':
                        conn.sendall(b'ready\n')
                    elif action == 'keep':
                        conn.sendall(b'done\n')
                        keep = True
                        return
                    elif action == 'revert':
                        apply(before, best_effort=True)
                        keep = True  # Already restored.
                        conn.sendall(b'done\n')
                        return
    finally:
        try:
            if changed and not keep:
                apply(before, best_effort=True)
        finally:
            shutil.rmtree(directory)
            if lock is not None:
                os.close(lock)


def main():
    if len(sys.argv) < 2:
        raise ValueError('Kullanım: display-preview preview JSON | keep/revert KİMLİK')
    expected = {'preview': 3, 'guard': 5, 'keep': 3, 'revert': 3}
    if len(sys.argv) != expected.get(sys.argv[1], 0):
        raise ValueError('Geçersiz işlem veya eksik argüman.')
    if sys.argv[1] == 'preview':
        before = current()
        draft = json.loads(sys.argv[2])
        validate(draft, before)
        directory = Path(tempfile.mkdtemp(prefix='vabu-display-', dir=runtime()))
        proc = subprocess.Popen([sys.executable, '-I', __file__, 'guard', directory.name,
                                 json.dumps(before), json.dumps(draft)],
                                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL, start_new_session=True, close_fds=True)
        for _ in range(100):
            if (directory / 'control').exists():
                request(directory.name, 'status')
                print(directory.name, flush=True)
                return
            if proc.poll() is not None:
                raise RuntimeError('Ekran önizlemesi başlatılamadı; eski ayarlar geri yüklenmeye çalışıldı.')
            time.sleep(0.05)
        proc.terminate()
        raise RuntimeError('Önizleme başlatma zaman aşımı.')
    elif sys.argv[1] == 'guard':
        guard(sys.argv[2], json.loads(sys.argv[3]), json.loads(sys.argv[4]))
    elif sys.argv[1] in ('keep', 'revert'):
        request(sys.argv[2], sys.argv[1])
    else:
        raise ValueError('Bilinmeyen işlem.')


if __name__ == '__main__':
    try:
        main()
    except (OSError, KeyError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
