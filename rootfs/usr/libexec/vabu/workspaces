#!/usr/bin/python3 -I
"""Render only validated named-workspace rules; launch desktop IDs only on opt-in."""
import configparser
import json
import os
from pathlib import Path
import re
import subprocess
import sys


def desktop_id(app):
    return app if isinstance(app, str) else app.get('desktopId', '') if isinstance(app, dict) else ''


def validate(data):
    if not isinstance(data, dict): raise ValueError("Geçersiz ayarlar.")
    workspaces = data.get('workspaces', [])
    if not isinstance(workspaces, list) or len(workspaces) > 12:
        raise ValueError('En fazla 12 çalışma alanı desteklenir.')
    seen = set()
    assigned = set()
    for item in workspaces:
        if not isinstance(item, dict): raise ValueError('Geçersiz çalışma alanı.')
        name = item.get('name')
        if not isinstance(name, str) or not name.strip() or len(name) > 40 or any(ord(c) < 32 for c in name) or name in seen:
            raise ValueError('Alan adları benzersiz, kısa ve boş olmayan metinler olmalı.')
        seen.add(name)
        apps = item.get('apps', [])
        if not isinstance(apps, list) or len(apps) > 30:
            raise ValueError('Geçersiz uygulama listesi.')
        for app in apps:
            entry = desktop_id(app)
            if not isinstance(entry, str) or not re.fullmatch(r'[A-Za-z0-9_.-]+', entry) or entry.startswith('-') or entry.removesuffix('.desktop') in assigned:
                raise ValueError('Uygulama kimliği geçersiz veya birden fazla alana atanmış.')
            assigned.add(entry.removesuffix('.desktop'))
            if isinstance(app, dict):
                for key in ('appId', 'title'):
                    value = app.get(key, '')
                    if not isinstance(value, str) or len(value) > 256 or any(ord(c) < 32 for c in value):
                        raise ValueError('Geçersiz pencere eşleştirmesi.')
                if not app.get('appId') or (app['appId'] == 'org.quickshell' and not app.get('title')):
                    raise ValueError('Paylaşılan pencere kimliği için başlık gerekli.')
    return workspaces


def match_ids(entry):
    # Native Wayland IDs and legacy XWayland StartupWMClass may differ.
    ids = [entry.removesuffix('.desktop')]
    homes = [os.environ.get('XDG_DATA_HOME', str(Path.home() / '.local/share'))]
    homes += os.environ.get('XDG_DATA_DIRS', '/usr/local/share:/usr/share').split(':')
    for home in homes:
        path = Path(home) / 'applications' / (entry if entry.endswith('.desktop') else entry + '.desktop')
        if not path.is_file(): continue
        if path.stat().st_size > 131072: break
        parser = configparser.ConfigParser(interpolation=None, strict=False)
        try:
            parser.read(path, encoding='utf-8')
            wmclass = parser.get('Desktop Entry', 'StartupWMClass', fallback='')
            if wmclass and len(wmclass) <= 256 and not any(ord(c) < 32 for c in wmclass): ids.append(wmclass)
        except (configparser.Error, UnicodeError): pass
        break
    return list(dict.fromkeys(ids))


def render(data):
    lines = []
    for item in validate(data):
        name = json.dumps(item['name'], ensure_ascii=False)
        lines.append('workspace ' + name)
        for app in item.get('apps', []):
            entry = desktop_id(app)
            if isinstance(app, dict):
                matches = '    match app-id=' + json.dumps('^' + re.escape(app['appId']) + '$')
                if app.get('title'): matches += ' title=' + json.dumps('^' + re.escape(app['title']) + '$')
            elif entry.removesuffix('.desktop') == 'so.vabu.Settings':
                matches = '    match app-id=' + json.dumps('^org' + re.escape('.') + 'quickshell$') + ' title=' + json.dumps('^Vabu Ayarlar$')
            else:
                matches = '\n'.join('    match app-id=' + json.dumps('^' + re.escape(value) + '$') for value in match_ids(entry))
            lines.append('window-rule {\n' + matches + '\n    open-on-workspace ' + name + '\n}')
    return '\n'.join(lines)


def main():
    if len(sys.argv) == 3 and sys.argv[1] == 'render':
        path = Path(sys.argv[2])
        print(render(json.loads(path.read_text()) if path.is_file() else {}))
    elif sys.argv[1:] == ['launch']:
        config = Path(os.environ.get('XDG_CONFIG_HOME', Path.home() / '.config')) / 'vabu'
        shell = json.loads((config / 'shell.json').read_text()) if (config / 'shell.json').is_file() else {}
        if shell.get('restoreWorkspaceApps') is not True: return
        data = json.loads((config / 'niri.json').read_text()) if (config / 'niri.json').is_file() else {}
        launched = set()
        for item in validate(data):
            for setting in item.get('apps', []):
                app = desktop_id(setting)
                if app in launched: continue
                launched.add(app)
                subprocess.Popen(['gtk-launch', app], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else: raise ValueError('Geçersiz işlem.')


if __name__ == '__main__':
    try: main()
    except (OSError, ValueError, KeyError) as e:
        print(str(e), file=sys.stderr)
        sys.exit(1)
