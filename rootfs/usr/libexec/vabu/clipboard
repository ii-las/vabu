#!/usr/bin/python3 -I
"""Opt-in, text-only clipboard history. Contents never go to disk or argv."""
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import signal
import socket
import stat
import subprocess
import sys
import tempfile
import time

LIMIT = 16384


def runtime():
    path = Path(os.environ['XDG_RUNTIME_DIR'])
    st = path.lstat()
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid() or st.st_mode & 0o077:
        raise ValueError('Güvenli oturum dizini gerekli.')
    return path


def endpoint(token):
    if not re.fullmatch(r'vabu-clipboard-[a-z0-9_]+', token):
        raise ValueError('Geçersiz oturum.')
    return runtime() / token / 'control'


def send(token, message):
    with socket.socket(socket.AF_UNIX) as client:
        client.settimeout(2)
        client.connect(str(endpoint(token)))
        client.sendall(json.dumps(message).encode() + b'\n')
        client.shutdown(socket.SHUT_WR)
        result = json.loads(client.recv(256))
        if not result.get('ok'):
            raise ValueError('Pano işlemi tamamlanamadı.')


def capture():
    # Unknown sensitivity state is ignored. Never read a password-manager selection.
    if os.environ.get('CLIPBOARD_STATE') != 'data':
        return
    check = subprocess.run(['wl-paste', '--list-types'], capture_output=True, timeout=2)
    if check.returncode or any(marker in check.stdout.lower() for marker in (b'password', b'sensitive', b'secret')):
        return
    data = sys.stdin.buffer.read(LIMIT + 1)
    if not data or len(data) > LIMIT:
        return
    text = data.decode('utf-8')
    if '\x00' in text or re.search(r'-----BEGIN .*PRIVATE KEY-----', text):
        return
    send(os.environ['VABU_CLIPBOARD_SOCKET'], {'action': 'add', 'text': text})


def serve():
    directory = Path(tempfile.mkdtemp(prefix='vabu-clipboard-', dir=runtime()))
    token = directory.name
    watcher = None
    entries = []
    def stop(*_):
        raise SystemExit(0)
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    def publish():
        print(json.dumps({'socket': token, 'entries': entries}, ensure_ascii=False), flush=True)
    try:
        with socket.socket(socket.AF_UNIX) as server:
            server.bind(str(endpoint(token)))
            server.listen(4)
            server.settimeout(5)
            publish()
            watcher = subprocess.Popen(['wl-paste', '--type', 'text', '--watch', sys.executable, '-I', __file__, 'capture'],
                                       env={**os.environ, 'VABU_CLIPBOARD_SOCKET': token},
                                       stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            while True:
                now = time.monotonic()
                fresh = [item for item in entries if now - item['time'] < 600]
                if len(fresh) != len(entries):
                    entries = fresh
                    publish()
                if watcher.poll() is not None:
                    raise RuntimeError('Pano izleyicisi kapandı; geçmiş temizlendi.')
                try:
                    conn, _ = server.accept()
                except socket.timeout:
                    continue
                with conn:
                    conn.settimeout(2)
                    payload = bytearray()
                    while len(payload) <= LIMIT * 7:
                        chunk = conn.recv(4096)
                        if not chunk: break
                        payload.extend(chunk)
                    try:
                        msg = json.loads(payload)
                        now = time.monotonic()
                        entries = [e for e in entries if now - e['time'] < 600]
                        action = msg.get('action')
                        if action == 'add':
                            text = msg.get('text')
                            if not isinstance(text, str) or not text or len(text.encode()) > LIMIT:
                                raise ValueError('invalid content')
                            key = hashlib.sha256(text.encode()).hexdigest()
                            entries = [{'id': key, 'text': text, 'time': now}] + [e for e in entries if e['id'] != key]
                            entries = entries[:20]
                        elif action == 'clear':
                            entries = []
                        elif action == 'delete':
                            entries = [e for e in entries if e['id'] != msg.get('id')]
                        elif action == 'copy':
                            item = next(e for e in entries if e['id'] == msg.get('id'))
                            subprocess.run(['wl-copy', '--type', 'text/plain;charset=utf-8'], input=item['text'].encode(), timeout=3, check=True)
                        else:
                            raise ValueError('invalid action')
                        conn.sendall(b'{"ok":true}')
                        publish()
                    except (ValueError, KeyError, StopIteration, subprocess.SubprocessError):
                        conn.sendall(b'{"ok":false}')
    finally:
        if watcher is not None and watcher.poll() is None:
            watcher.terminate()
            try: watcher.wait(timeout=2)
            except subprocess.TimeoutExpired: watcher.kill(); watcher.wait()
        entries.clear()
        shutil.rmtree(directory)


def main():
    args = sys.argv[1:]
    if args == ['serve']: serve()
    elif args == ['capture']: capture()
    elif len(args) in (2, 3) and args[0] in ('clear', 'copy', 'delete'):
        send(args[1], {'action': args[0], 'id': args[2] if len(args) == 3 else ''})
    else: raise ValueError('Geçersiz pano işlemi.')


if __name__ == '__main__':
    try: main()
    except (OSError, ValueError, RuntimeError, UnicodeError, subprocess.SubprocessError):
        print('Pano geçmişi kullanılamıyor.', file=sys.stderr)
        sys.exit(1)
