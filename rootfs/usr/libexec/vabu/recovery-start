#!/usr/bin/env bash
# Recovery uses packaged fallback tools, independent of Vabu Shell and user niri config.
start() { "$@" >/dev/null 2>&1 & }
start lxqt-policykit-agent
start nm-applet
start mako --config /usr/share/vabu/mako/config
start waybar -c /usr/share/vabu/waybar/config.jsonc -s /usr/share/vabu/waybar/style.css
start swaybg -c '#15181E'
start swayidle -w timeout 300 '/usr/libexec/vabu/lock' before-sleep '/usr/libexec/vabu/lock'
# The installed fallback session is not an offline live-ISO recovery environment.
exec foot --title 'Vabu Kurtarma' bash -c 'printf "Vabu Kurtarma\nBu kurulu oturum tam sistem geri alma ortamı değildir; canlı ISO ile aç.\n\nvabu doctor     Sistem denetimi\nvabu recovery-check Salt okunur çekirdek ve /boot denetimi\nvabu reset niri Ayarları yedekleyip sıfırla\n\n"; exec bash'
