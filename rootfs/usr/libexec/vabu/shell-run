#!/usr/bin/env bash
# Kabuk herhangi bir zamanda çökerse kaydı göster; otomatik çökme döngüsü oluşturma.
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/vabu"
LOG="$STATE/shell.log"
mkdir -p "$STATE" "${XDG_CONFIG_HOME:-$HOME/.config}/vabu"
[[ -f "$LOG" ]] && mv -f "$LOG" "$LOG.1"
qs -p /usr/share/vabu/shell >"$LOG" 2>&1
code=$?
(( code == 0 )) && exit 0
exec foot --app-id vabu-shell-error --title "Vabu Shell kapandı" bash -c '
    printf "Vabu Shell kapandı (çıkış kodu %s)\nKayıt: %s\n\n" "$1" "$2"
    tail -n 60 -- "$2"
    printf "\nYeniden denemek için Enter, kapatmak için Ctrl+D.\n"
    read -r _ && exec /usr/libexec/vabu/shell-run
' vabu-shell-error "$code" "$LOG"
