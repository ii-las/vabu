[Unit]
Description=Vabu: güncellemeleri arka planda indir (kurulum kullanıcının onayıyla yapılır)
Wants=network-online.target
After=network-online.target
ConditionACPower=true

[Service]
Type=oneshot
# Sadece indirir; kurulum Vabu Ayarlar > Güncellemeler'den ya da `vabu update` ile yapılır.
ExecStart=/usr/libexec/vabu/update-events run background-rpm
# Flatpak kurulumu kullanıcının başlattığı vabu update işlemine bırakılır.
Nice=19
IOSchedulingClass=idle
