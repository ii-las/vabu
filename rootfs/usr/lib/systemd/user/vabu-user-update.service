[Unit]
Description=Kullanıcı Flatpak uygulamalarını ve distrobox kutularını güncelle
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/vabu/update-events run background-flatpak
ExecStart=-/usr/libexec/vabu/update-events run background-distrobox
Nice=19
